# Order Service Environment Variables

# Django Secret Key
SECRET_KEY=Your Django secret key here
# Debug mode (True for development, False for production)
DEBUG=True or False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS= Allowed hostnames for the Django application

JWKS_SERVING_URL=your jwks serving urls end will like this -->.well-known/jwks.json

AUTH_SERVICE_URL= your auth service url
ORDER_SERVICE_URL=your order service url
PRODUCT_SERVICE_URL=your product service url
